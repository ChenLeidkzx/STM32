# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/

# 系统文件
.DS_Store

# ---- 隐私保护：以下文件一律不提交 ----
# 环境变量 / 配置文件（可能含密码、密钥）
.env
.env.*
*.local

# 密钥 / 证书
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# 凭据 / 令牌
credentials.json
config.json
token*
*.secret

# 日志（可能记录命令/路径）
*.log
logs/

# 本地自动同步脚本运行日志
sync.log
